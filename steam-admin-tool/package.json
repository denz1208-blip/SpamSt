{
  "name": "steam-admin-tool",
  "version": "1.0.0",
  "description": "Self-community administration tool for Steam: posting comments to your own groups/discussions from a pool of assistant accounts. Legitimate use only.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "login:qr": "node src/index.js --login-qr",
    "report": "node src/index.js --report-only",
    "lint": "echo 'add eslint if needed'"
  },
  "keywords": [
    "steam",
    "steam-user",
    "steamcommunity",
    "group-admin",
    "self-community"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "lowdb": "^7.0.1",
    "node-cron": "^3.0.3",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.0.1",
    "steamcommunity": "^3.46.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
